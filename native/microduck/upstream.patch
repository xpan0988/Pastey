+            environment: "env".into(),
+            domain: "motion".into(),
+            body: "body".into(),
+            body_ref: "duck".into(),
+            world: "world".into(),
+            controller: task_authority::controller_incarnation().unwrap(),
+        };
+        intents.task.configure(identity.clone()).unwrap();
+        let now = proto::clock::monotonic_ns() / 1000;
+        let mut install = Install {
+            protocol: PROTOCOL.into(),
+            profile: PROFILE.into(),
+            identity,
+            domain: "motion".into(),
+            session: "session".into(),
+            epoch: 1,
+            request: "install".into(),
+            lease_deadline_us: now + 2_000_000,
+        };
+        let mut action = Action {
+            install: install.clone(),
+            action: "action".into(),
+            payload_digest: "a".repeat(64),
+            deadline_us: now + 1_000_000,
+        };
+        let mut movement = Move {
+            action: action.clone(),
+            request: "move".into(),
+            sequence: 1,
+            twist: [0.05, 0.0, 0.0],
+        };
+        assert!(
+            intents
+                .task
+                .request_live(
+                    &Request::Install {
+                        descriptor: install.clone()
+                    },
+                    1
+                )
+                .accepted
