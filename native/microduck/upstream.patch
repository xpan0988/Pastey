+        assert!(
+            intents
+                .task
+                .request_live(
+                    &Request::Admit {
+                        descriptor: action.clone()
+                    },
+                    1
+                )
+                .accepted
+        );
+        assert!(
+            intents
+                .task
+                .request_live(
+                    &Request::Move {
+                        descriptor: movement.clone()
+                    },
+                    1
+                )
+                .accepted
+        );
+        let mut contention = intents.task.consume().unwrap();
+        assert_eq!(contention.twist(now), [0.05, 0.0, 0.0]);
+        if controller_loss {
+            intents.task.inject_controller_failure();
+        }
+        let (entered, release) = intents.task.inject_pause(true);
+        let state = Arc::new(RobotState::new(
+            &Params::default(),
+            Path::new("/nonexistent"),
+            false,
+            false,
+        ));
