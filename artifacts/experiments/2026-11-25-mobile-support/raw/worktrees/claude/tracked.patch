+/// This device's own IPv4 addresses on private or overlay networks, for
+/// another device to type when it pairs by address: a phone cannot count on
+/// broadcast discovery (docs/research/mobile-support.md, "Pairing"). Read
+/// only; it shows what the interface list already shows and grants nothing.
+pub(crate) fn local_private_ipv4_addresses() -> Vec<Ipv4Addr> {
+    let mut addresses: Vec<Ipv4Addr> = discovery_interfaces()
+        .into_iter()
+        .map(|interface| interface.ipv4)
+        .collect();
+    // `ip` and `ifconfig` do not exist everywhere (Windows has neither). The
+    // address the system would use toward a private network is the fallback:
+    // connecting a UDP socket sends nothing, it only selects the route.
+    if let Ok(socket) = std::net::UdpSocket::bind(("0.0.0.0", 0)) {
+        if socket.connect(("192.168.0.1", 9)).is_ok() {
+            if let Ok(SocketAddr::V4(local)) = socket.local_addr() {
+                addresses.push(*local.ip());
+            }
+        }
+    }
+    addresses.retain(|ip| is_private_or_overlay_ipv4(*ip));
+    addresses.sort();
+    addresses.dedup();
+    addresses
+}
