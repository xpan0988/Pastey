+/** Stores a file's bytes in this device's temp folder and returns the path.
+ * Unlike `writeTempFile`, the bytes travel as the request body rather than as
+ * a JSON array of numbers, so a photo or a document is affordable on a phone.
+ * The name rides in a header as URL-safe base64 of its UTF-8 text. */
+export async function writeTempFileRaw(fileName: string, bytes: Uint8Array): Promise<string> {
+  let binary = "";
+  for (const byte of new TextEncoder().encode(fileName)) binary += String.fromCharCode(byte);
+  const encodedName = btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+  return invoke("write_temp_file_raw", bytes, { headers: { "x-file-name": encodedName } });
+}
