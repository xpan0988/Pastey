+test("a phone sends files it was handed as bytes, and says which it left out", async () => {
+  const big = new File([new Uint8Array(10)], "big.bin");
+  // Over the limit: never read, never stored.
+  const result = await stagePickedFiles([big], 5);
+  assert.deepEqual(result.tooLarge, ["big.bin"]);
+  assert.deepEqual(result.staged, []);
+  assert.deepEqual(result.failed, []);
+  assert.match(skippedFilesMessage(result, 5 * 1024 * 1024) ?? "", /big\.bin is over 5 MB/);
+  // Under Node there is no Pastey to store the bytes: reported, not queued.
+  const unstorable = await stagePickedFiles([new File([new Uint8Array(3)], "note.txt")]);
+  assert.deepEqual(unstorable.staged, []);
+  assert.deepEqual(unstorable.failed, ["note.txt"]);
+  assert.equal(skippedFilesMessage({ staged: [], tooLarge: [], failed: [] }), null);
+  assert.match(skippedFilesMessage({ staged: [], tooLarge: ["a", "b", "c"], failed: ["d"] }) ?? "", /a and 2 more are over 64 MB.*d could not be read\./);
+});
