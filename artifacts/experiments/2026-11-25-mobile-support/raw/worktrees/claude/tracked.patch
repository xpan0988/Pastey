+/// Like `write_temp_file`, but the bytes arrive as the request's raw body
+/// instead of a JSON array of numbers, which a phone cannot afford for a file
+/// of a few megabytes. The name is in the `x-file-name` header as URL-safe
+/// base64 of its UTF-8 text, since a header cannot carry arbitrary text. Used
+/// where the frontend holds a file's bytes but no path: a phone's file picker
+/// (docs/research/mobile-support.md, "Sending").
+#[tauri::command]
+pub fn write_temp_file_raw(
+    request: tauri::ipc::Request,
+    state: State<'_, Arc<AppState>>,
+) -> Result<String, String> {
+    use base64::Engine as _;
+    let tauri::ipc::InvokeBody::Raw(bytes) = request.body() else {
+        return Err("the file's bytes were not sent as a raw body".into());
+    };
+    let file_name = request
+        .headers()
+        .get("x-file-name")
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| {
+            base64::engine::general_purpose::URL_SAFE_NO_PAD
+                .decode(value)
+                .ok()
+        })
+        .and_then(|decoded| String::from_utf8(decoded).ok())
+        .unwrap_or_default();
+    let path = storage::write_temp_file(&state.paths, &file_name, bytes)
+        .map_err(|error| error.message())?;
+    Ok(path.display().to_string())
+}
