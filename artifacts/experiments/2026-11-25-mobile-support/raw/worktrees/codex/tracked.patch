+#[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+async fn mobile_companion_exchanges_text_and_follows_a_desktop_reviewed_turn() {
+    use crate::{models::RoomItemDirection, native_agent::NativeAgentTaskStateV1};
+
+    let pair = RuntimePairV1::with_requester(true).await;
+    assert!(pair.mac.runtime.native_agents.lock().capabilities().is_empty());
+
+    for (sender, receiver, message) in [
+        (&pair.mac, &pair.windows, "Hello desktop"),
+        (&pair.windows, &pair.mac, "Hello mobile"),
+    ] {
+        let master_key = crate::config::master_key(&sender.runtime.config.read()).unwrap();
+        let outgoing =
+            storage::create_outgoing_text_item(&sender.runtime.paths, &master_key, ROOM, message)
+                .unwrap();
+        let session = sender
+            .runtime
+            .resolve_current_remote_host_session(ROOM, &receiver.host_ref())
+            .await
+            .unwrap();
+        crate::transfer::send_room_item_to_bridge_peer_endpoint(
+            sender.runtime.clone(),
+            ROOM,
+            &outgoing.id,
+            session.transfer_endpoint().clone(),
+        )
+        .await
+        .unwrap();
+        let master_key = crate::config::master_key(&receiver.runtime.config.read()).unwrap();
+        let incoming = storage::get_room_item_by_id(&receiver.runtime.paths, &outgoing.id).unwrap();
+        let incoming = storage::room_item_to_info(&receiver.runtime.paths, &master_key, incoming)
+            .unwrap();
+        assert_eq!(incoming.direction, RoomItemDirection::Incoming);
+        assert_eq!(incoming.text.as_deref(), Some(message));
+    }
+
+    let unexpected = reqwest::Client::new()
+        .post(format!("http://127.0.0.1:{}/rooms/{ROOM}/transfers/start", pair.mac.port))
+        .send()
+        .await
+        .unwrap();
+    assert_eq!(unexpected.status(), reqwest::StatusCode::NOT_FOUND);
+    assert!(pair.windows_checks_mac_capabilities().await.is_err());
+
+    let codex = install_windows_codex(&pair);
+    pair.windows_shares(&codex, true, true).await;
+    let shares = pair.mac_lists_shares().await.unwrap();
+    let task = pair.mac_continues(&shares.scopes[0].scope_ref).await.unwrap();
+    pair.windows_review_appears(&task.task_id).await;
+    assert_eq!(codex.turn_starts(), 0);
+    pair.windows_accepts(&task.task_id).unwrap();
+    assert_eq!(
+        pair.mac_task_ends(&task.task_id).await.state,
+        NativeAgentTaskStateV1::Completed
+    );
+    assert_eq!(codex.turn_starts(), 1);
+}
